{
  "openapi": "3.1.0",
  "info": {
    "title": "Synthetic fixture",
    "version": "1.0"
  },
  "paths": {},
  "components": {
    "schemas": {
      "Page": {
        "type": "object",
        "properties": {
          "catalog": {
            "$ref": "#/components/schemas/Catalog"
          },
          "inventory": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Inventory"
            }
          },
          "extra": {}
        },
        "required": [
          "catalog",
          "inventory"
        ]
      },
      "Catalog": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Item"
            }
          },
          "cursor": {
            "type": "string"
          },
          "summary": {
            "type": "object",
            "properties": {
              "total": {
                "type": "integer"
              },
              "available": {
                "type": "integer"
              }
            },
            "required": [
              "total",
              "available"
            ]
          }
        },
        "required": [
          "items",
          "summary"
        ]
      },
      "Item": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string"
          },
          "price": {
            "$ref": "#/components/schemas/Price"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "related": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Item",
              "nullable": true
            }
          },
          "owner": {
            "$ref": "#/components/schemas/Account"
          }
        },
        "required": [
          "id",
          "name",
          "price",
          "tags"
        ]
      },
      "Price": {
        "type": "object",
        "properties": {
          "amount": {
            "type": "number",
            "format": "double"
          },
          "currency": {
            "type": "string"
          }
        },
        "required": [
          "amount",
          "currency"
        ]
      },
      "Account": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "displayName": {
            "type": "string"
          },
          "address": {
            "type": "object",
            "properties": {
              "city": {
                "type": "string"
              },
              "phones": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "city"
            ]
          }
        },
        "required": [
          "id"
        ]
      },
      "Inventory": {
        "type": "object",
        "properties": {
          "item": {
            "$ref": "#/components/schemas/Item"
          },
          "quantity": {
            "type": "integer"
          },
          "warehouseCode": {
            "type": "string"
          }
        },
        "required": [
          "item",
          "quantity"
        ]
      }
    }
  }
}
