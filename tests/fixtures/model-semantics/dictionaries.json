      "Open": {"type": "object", "additionalProperties": true},
      "Labels": {"type": "object", "additionalProperties": {"enum": ["ready", "done"]}},
      "Choices": {"type": "object", "additionalProperties": {"oneOf": [{"type": "string"}, {"type": "boolean"}]}},
      "Lists": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "object", "required": ["id"], "properties": {"id": {"type": "string"}}}}},
      "Objects": {"type": "object", "additionalProperties": {"type": "object", "required": ["id"], "properties": {"id": {"type": "string"}}}},
      "Nullable": {"type": ["object", "null"], "additionalProperties": {"type": "string"}},
      "Tree": {"type": "object", "additionalProperties": {"type": "object", "properties": {"children": {"$ref": "#/components/schemas/Tree"}}}},
      "Closed": {"type": "object", "additionalProperties": false},
      "Fixed": {"type": "object", "required": ["id"], "properties": {"id": {"type": "string"}}, "additionalProperties": {"type": "integer"}},
