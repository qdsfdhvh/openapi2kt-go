          "inline": {"additionalProperties": {"type": "object", "required": ["id"], "properties": {"id": {"type": "string"}}}},
          "statuses": {"type": "object", "additionalProperties": {"enum": ["ready", "done"]}},
          "nested": {"type": "object", "additionalProperties": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "number"}}}},
          "open": {"$ref": "#/components/schemas/Open"},
          "objects": {"$ref": "#/components/schemas/Objects"},
          "optional": {"type": "object", "additionalProperties": {"type": "string"}},
          "nullable": {"$ref": "#/components/schemas/Nullable"},
          "wrapped": {"allOf": [{"$ref": "#/components/schemas/Counts"}], "nullable": true},
          "choice": {"type": "object", "additionalProperties": {"oneOf": [{"type": "string"}, {"type": "boolean"}]}},
          "folded": {"anyOf": [{"type": "object", "additionalProperties": {"type": "string"}}, {"type": "null"}]}
        }
