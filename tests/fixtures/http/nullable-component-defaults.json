      },
      "Day": {
        "type": ["string", "null"],
        "format": "date",
        "default": "2024-02-29"
      },
      "Names": {
        "type": ["array", "null"],
        "items": {
          "type": "string"
        },
        "default": ["a", "b"]
      },
      "Counts": {
        "type": ["object", "null"],
        "additionalProperties": {
          "type": "integer"
        },
        "default": {
          "k": 1
        }
      },
      "Label": {
        "type": "object",
        "nullable": true,
        "required": ["z"],
        "properties": {
          "z": {
            "type": "string"
          }
        },
        "default": {
          "z": "label"
        }
      },
      "Mode": {
        "type": ["string", "null"],
        "enum": ["a", "b"],
        "default": "a"
      },
      "Holder": {
        "type": "object",
        "properties": {
          "name": {
            "$ref": "#/components/schemas/Name"
          },
          "names": {
            "$ref": "#/components/schemas/Names"
          },
          "inline": {
