{
  "openapi": "3.1.0",
  "info": {
    "title": "nullable-component-defaults",
    "version": "1.0.0"
  },
  "paths": {
    "/x": {
      "post": {
        "operationId": "x",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Holder"
              }
            }
          }
        },
        "responses": {
          "204": {}
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Name": {
        "type": ["string", "null"],
