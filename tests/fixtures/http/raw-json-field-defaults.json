{
  "openapi": "3.1.0",
  "info": {
    "title": "Raw JSON field defaults",
    "version": "1"
  },
  "components": {
    "schemas": {
      "Holder": {
        "type": "object",
        "properties": {
          "open": {
            "type": "object",
            "additionalProperties": true,
            "default": {
              "a": 1,
              "b": [
                true,
                null
              ]
            }
          },
          "free": {
            "default": [
              1,
              2,
              3
            ]
          },
          "empty": {
            "type": "object",
            "default": {
              "x": "y"
            }
          }
        }
      }
    }
  },
  "paths": {
    "/holder": {
      "post": {
        "operationId": "sendHolder",
        "tags": [
          "defaults"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Holder"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Holder",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Holder"
                }
              }
            }
          }
        }
      }
    },
    "/inline": {
      "post": {
        "operationId": "sendInline",
        "tags": [
          "defaults"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "u": {
                    "oneOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "integer",
                        "format": "int32"
                      }
                    ],
                    "default": "x"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "ok"
          }
        }
      }
    },
    "/events": {
      "get": {
        "operationId": "watchHolders",
        "tags": [
          "defaults"
        ],
        "responses": {
          "200": {
            "description": "Events",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "event": {
                      "const": "holder"
                    },
                    "data": {
                      "$ref": "#/components/schemas/Holder"
                    }
                  },
                  "required": [
                    "event",
                    "data"
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
