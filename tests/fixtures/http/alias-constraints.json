  "/patch":{"post":{"tags":["Aliases"],"operationId":"patch","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","properties":{"id":{"$ref":"#/components/schemas/Link","nullable":true}}}}}},"responses":{"204":{}}}},
  "/values":{"post":{"tags":["Aliases"],"operationId":"values","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"array","items":{"type":"object","additionalProperties":{"$ref":"#/components/schemas/Link","nullable":true}}}}}},"responses":{"200":{"content":{"application/json":{"schema":{"type":"array","items":{"type":"object","additionalProperties":{"$ref":"#/components/schemas/Link","nullable":true}}}}}}}}},
  "/params":{"get":{"tags":["Aliases"],"operationId":"params","parameters":[{"name":"ids","in":"query","schema":{"type":"array","items":{"$ref":"#/components/schemas/Link","nullable":true}}},{"name":"counts","in":"query","schema":{"type":"object","additionalProperties":{"$ref":"#/components/schemas/Count"}}},{"name":"code","in":"header","schema":{"$ref":"#/components/schemas/Id"}},{"name":"ratio","in":"query","schema":{"$ref":"#/components/schemas/Ratio"}}],"responses":{"204":{}}}},
