  "/id":{"post":{"tags":["Aliases"],"operationId":"id","requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Link"}}}},"responses":{"200":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/Id"}}}}}}},
