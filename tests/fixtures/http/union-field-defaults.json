                "schema": {
                  "$ref": "#/components/schemas/Holder"
                }
              }
            }
          }
        }
      }
    },
    "/closed": {
      "patch": {
        "operationId": "patchClosed",
        "tags": ["defaults"],
        "requestBody": {
          "required": true,
          "content": {"application/json": {"schema": {
            "type": "object",
            "properties": {"closed": {
              "$ref": "#/components/schemas/Closed",
              "nullable": true,
              "default": {"type": "Variant1", "value": "patch"}
            }}
          }}}
        },
        "responses": {"204": {"description": "Updated"}}
      }
    },
