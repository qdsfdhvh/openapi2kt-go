        "tags": [
          "defaults"
        ],
        "responses": {
          "200": {
            "description": "Events",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "event": {
                      "const": "holder"
                    },
                    "data": {
                      "$ref": "#/components/schemas/Holder"
                    }
                  },
                  "required": [
                    "event",
                    "data"
                  ]
                }
              }
            }
          }
        }
      }
    },
