{
  "openapi": "3.1.0",
  "info": {
    "title": "Synthetic JSON uniqueness",
    "version": "1"
  },
  "components": {
    "schemas": {
      "Record": {
        "properties": {
          "values": {
            "type": "array",
            "items": true,
            "uniqueItems": true
          },
          "objects": {
            "type": "array",
            "items": {
              "additionalProperties": true
            },
            "uniqueItems": true
          },
          "nested": {
            "type": "array",
            "items": {
              "type": "array",
              "items": true,
              "uniqueItems": true
            }
          },
          "optional": {
            "type": [
              "array",
              "null"
            ],
            "items": true,
            "uniqueItems": true
          },
          "referenced": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AnyBridge"
            },
            "uniqueItems": true
          },
          "raw": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Raw"
            },
            "uniqueItems": true
          },
          "covered": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "#/components/schemas/CoverBridge"
            }
          },
          "selfCovered": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "#/components/schemas/SelfCover"
            }
          },
          "coveredMap": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "$ref": "#/components/schemas/CoverAlias"
              }
            }
          },
          "composed": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "#/components/schemas/ComposedBridge"
            }
          },
          "composedMap": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/ComposedRows"
            }
          }
        },
        "required": [
          "values"
        ]
      },
      "Rows": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/AnyAlias"
        },
        "uniqueItems": true
      },
      "Holder": {
        "properties": {
          "rows": {
            "$ref": "#/components/schemas/Rows"
          }
        }
      },
      "Raw": {
        "type": "object",
        "nullable": true
      },
      "AnyValue": true,
      "AnyAlias": {
        "$ref": "#/components/schemas/AnyValue",
        "nullable": true
      },
      "Hops": {
        "properties": {
          "ref": {
            "$ref": "#/components/schemas/AnyAlias",
            "nullable": false
          },
          "coverRef": {
            "$ref": "#/components/schemas/CoverAlias",
            "nullable": false
          },
          "composedRef": {
            "$ref": "#/components/schemas/ComposedAlias",
            "nullable": false
          }
        }
      },
      "AnyBridge": {
        "$ref": "#/components/schemas/Hops/properties/ref"
      },
      "SelfCover": {
        "oneOf": [
          {
            "type": "null"
          },
          {
            "type": "string"
          },
          {
            "type": "boolean"
          },
          {
            "type": "number"
          },
          {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SelfCover"
            }
          },
          {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/SelfCover"
            }
          }
        ]
      },
      "Cover": {
        "oneOf": [
          {
            "type": "null"
          },
          {
            "type": "string"
          },
          {
            "type": "boolean"
          },
          {
            "type": "number"
          },
          {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ToPeer"
            }
          },
          {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/Peer"
            }
          }
        ]
      },
      "Peer": {
        "oneOf": [
          {
            "type": "null"
          },
          {
            "type": "string"
          },
          {
            "type": "boolean"
          },
          {
            "type": "number"
          },
          {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ToCover"
            }
          },
          {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/Cover"
            }
          }
        ]
      },
      "ToPeer": {
        "$ref": "#/components/schemas/Peer"
      },
      "ToCover": {
        "$ref": "#/components/schemas/Cover"
      },
      "CoverAlias": {
        "$ref": "#/components/schemas/Cover",
        "nullable": true
      },
      "CoverBridge": {
        "$ref": "#/components/schemas/Hops/properties/coverRef"
      },
      "CoveredRows": {
        "type": "array",
        "uniqueItems": true,
        "items": {
          "$ref": "#/components/schemas/CoverAlias"
        }
      },
      "CoveredHolder": {
        "properties": {
          "rows": {
            "$ref": "#/components/schemas/CoveredRows"
          }
        }
      },
      "ComposedBase": {
        "type": "object"
      },
      "ComposedRaw": {
        "allOf": [
          {
            "allOf": [
              {
                "$ref": "#/components/schemas/ComposedBase"
              },
              {
                "properties": {}
              }
            ]
          },
          {
            "type": "object"
          }
        ]
      },
      "ComposedAlias": {
        "$ref": "#/components/schemas/ComposedRaw",
        "nullable": true
      },
      "ComposedBridge": {
        "$ref": "#/components/schemas/Hops/properties/composedRef"
      },
      "ComposedRows": {
        "type": "array",
        "uniqueItems": true,
        "items": {
          "$ref": "#/components/schemas/ComposedAlias"
        }
      },
      "ComposedHolder": {
        "properties": {
          "rows": {
            "$ref": "#/components/schemas/ComposedRows"
          }
        }
      }
    }
  },
  "paths": {
    "/unique": {
      "post": {
        "operationId": "applyUnique",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "required": {
                    "type": "array",
                    "items": {
                      "$ref": "#/components/schemas/AnyBridge"
                    },
                    "uniqueItems": true
                  },
                  "patch": {
                    "type": [
                      "array",
                      "null"
                    ],
                    "items": {
                      "$ref": "#/components/schemas/Raw",
                      "nullable": false
                    },
                    "uniqueItems": true
                  },
                  "covered": {
                    "type": [
                      "array",
                      "null"
                    ],
                    "uniqueItems": true,
                    "items": {
                      "$ref": "#/components/schemas/CoverAlias"
                    }
                  },
                  "composed": {
                    "type": [
                      "array",
                      "null"
                    ],
                    "uniqueItems": true,
                    "items": {
                      "$ref": "#/components/schemas/ComposedAlias"
                    }
                  }
                },
                "required": [
                  "required"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Record"
                }
              }
            }
          }
        }
      }
    },
    "/watch": {
      "get": {
        "operationId": "watchUnique",
        "responses": {
          "200": {
            "content": {
              "text/event-stream": {
                "schema": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "event": {
                          "const": "sample"
                        },
                        "data": {
                          "$ref": "#/components/schemas/Record"
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/cover": {
      "post": {
        "operationId": "applyCovered",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CoveredRows"
              }
            }
          }
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CoveredRows"
                }
              }
            }
          }
        }
      }
    },
    "/composed": {
      "post": {
        "operationId": "applyComposed",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ComposedRows"
              }
            }
          }
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ComposedRows"
                }
              }
            }
          }
        }
      }
    }
  }
}
