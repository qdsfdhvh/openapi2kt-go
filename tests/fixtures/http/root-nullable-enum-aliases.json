{
  "openapi": "3.1.0",
  "info": {
    "title": "Root Nullable Enum Alias API",
    "version": "1"
  },
  "components": {
    "schemas": {
      "AInherited": {
        "$ref": "#/components/schemas/BNullable"
      },
      "BNullable": {
        "$ref": "#/components/schemas/ZStatus",
        "nullable": true
      },
      "AFalse": {
        "$ref": "#/components/schemas/AInherited",
        "nullable": false
      },
      "ATrue": {
        "$ref": "#/components/schemas/AFalse",
        "nullable": true
      },
      "Holder": {
        "properties": {
          "inherited": {
            "$ref": "#/components/schemas/AInherited"
          },
          "forcedFalse": {
            "$ref": "#/components/schemas/AInherited",
            "nullable": false
          },
          "forcedTrue": {
            "$ref": "#/components/schemas/AFalse",
            "nullable": true
          },
          "wrapper": {
            "allOf": [
              {
                "$ref": "#/components/schemas/AInherited"
              }
            ]
          },
          "wrapperFalse": {
            "allOf": [
              {
                "$ref": "#/components/schemas/AInherited"
              },
              {
                "nullable": false
              }
            ]
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AInherited"
            }
          },
          "values": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/AInherited"
            }
          }
        },
        "required": [
          "inherited",
          "forcedFalse",
          "forcedTrue",
          "wrapper",
          "wrapperFalse",
          "items",
          "values"
        ]
      },
      "ZStatus": {
        "type": "string",
        "enum": [
          "ready",
          "done"
        ]
      }
    }
  },
  "paths": {
    "/alias": {
      "post": {
        "operationId": "echo",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AInherited"
              }
            }
          }
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AInherited"
                }
              }
            }
          }
        }
      }
    },
    "/direct": {
      "post": {
        "operationId": "echo",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ZStatus"
              }
            }
          }
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ZStatus"
                }
              }
            }
          }
        }
      }
    },
    "/optional": {
      "post": {
        "operationId": "optional",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ATrue"
              }
            }
          }
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ATrue"
                }
              }
            }
          }
        }
      }
    },
    "/patch": {
      "patch": {
        "operationId": "submit",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "requiredNull": {
                    "$ref": "#/components/schemas/AInherited"
                  },
                  "requiredFalse": {
                    "$ref": "#/components/schemas/AInherited",
                    "nullable": false
                  },
                  "inherited": {
                    "$ref": "#/components/schemas/AInherited"
                  },
                  "forcedFalse": {
                    "$ref": "#/components/schemas/AInherited",
                    "nullable": false
                  },
                  "forcedTrue": {
                    "$ref": "#/components/schemas/AFalse",
                    "nullable": true
                  },
                  "wrapper": {
                    "allOf": [
                      {
                        "$ref": "#/components/schemas/AInherited"
                      }
                    ]
                  },
                  "wrapperFalse": {
                    "allOf": [
                      {
                        "$ref": "#/components/schemas/AInherited"
                      },
                      {
                        "nullable": false
                      }
                    ]
                  }
                },
                "required": [
                  "requiredNull",
                  "requiredFalse"
                ]
              }
            }
          }
        },
        "responses": {
          "204": {}
        }
      }
    },
    "/events": {
      "get": {
        "operationId": "watch",
        "responses": {
          "200": {
            "content": {
              "text/event-stream": {
                "schema": {
                  "oneOf": [
                    {
                      "properties": {
                        "event": {
                          "type": "string",
                          "const": "nullable"
                        },
                        "data": {
                          "$ref": "#/components/schemas/AInherited"
                        }
                      },
                      "required": [
                        "data"
                      ]
                    },
                    {
                      "properties": {
                        "event": {
                          "type": "string",
                          "const": "narrow"
                        },
                        "data": {
                          "$ref": "#/components/schemas/AInherited",
                          "nullable": false
                        }
                      },
                      "required": [
                        "data"
                      ]
                    }
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
