{
  "openapi": "3.1.0",
  "info": {"title": "Response Kind", "version": "1.0"},
  "servers": [{"url": "https://api.example.test"}],
  "paths": {
    "/choice": {"get": {"operationId": "choice", "responses": {"200": {"content": {"application/json": {"schema": {"anyOf": [
      {"type": "object", "required": ["kind"], "properties": {"kind": {"const": "left"}, "id": {"type": "string"}}},
      {"type": "object", "required": ["kind"], "properties": {"kind": {"const": "right"}, "count": {"type": "integer"}}}
    ]}}}}}}},
    "/kind": {"get": {"operationId": "kind", "responses": {"200": {"content": {"application/json": {"schema": {"oneOf": [{"type": "string"}, {"type": "boolean"}]}}}}}}},
    "/nullable-kind": {"get": {"operationId": "nullableKind", "responses": {"200": {"content": {"application/json": {"schema": {"anyOf": [{"type": "string"}, {"type": "boolean"}, {"type": "null"}]}}}}}}},
    "/open": {"get": {"operationId": "openValue", "responses": {"200": {"content": {"application/json": {"schema": {"anyOf": [{"type": "string", "enum": ["known"]}, {"type": "string"}]}}}}}}},
    "/void": {"get": {"operationId": "empty", "responses": {
      "200": {"content": {"application/json": {"schema": {"type": "null"}}}},
      "201": {"content": {"application/json": {"schema": {"type": "object", "properties": {"ignored": {"type": "boolean"}}}}}}
    }}}
  }
}
