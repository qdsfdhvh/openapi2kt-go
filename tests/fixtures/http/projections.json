{
  "openapi": "3.1.0",
  "info": {"title": "Projection", "version": "1.0"},
  "servers": [{"url": "https://api.example.test"}],
  "components": {"schemas": {"Record": {"type": "object", "required": ["id"], "properties": {"id": {"type": "string"}}}}},
  "paths": {
    "/enum": {"get": {"operationId": "enumValue", "responses": {"200": {"content": {"application/json": {"schema": {"type": "string", "enum": ["a", "b"]}}}}}}},
    "/enum-list": {"get": {"operationId": "enumList", "responses": {"200": {"content": {"application/json": {"schema": {"type": "array", "items": {"type": "string", "enum": ["a", "b"]}}}}}}}},
    "/send": {"post": {"operationId": "sendEnum", "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "string", "enum": ["a", "b"]}}}}, "responses": {"204": {}}}},
    "/nullable-object": {"get": {"operationId": "nullableObject", "responses": {"200": {"content": {"application/json": {"schema": {"anyOf": [
      {"type": "object", "properties": {"id": {"type": "string"}}}, {"type": "null"}
    ]}}}}}}},
    "/nullable-ref": {"get": {"operationId": "nullableRef", "responses": {"200": {"content": {"application/json": {"schema": {"anyOf": [{"$ref": "#/components/schemas/Record"}, {"type": "null"}]}}}}}}}
  }
}
