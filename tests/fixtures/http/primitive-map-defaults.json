              "east": "2024-02-29T12:34:56+18:00",
              "west": "2024-02-29T12:34:56-18:00",
              "zero": "2024-02-29T12:34:56-00:00",
              "year": "0000-01-01T00:00:00Z",
              "nil": null
            }
          },
          "emptyDates": {
            "type": "object",
            "additionalProperties": {"type": "string", "format": "date", "default": "2000-01-01"},
            "default": {}
