          "kotlin": {
            "type": "string"
          },
          "kotlinx": {
            "type": "string"
          },
          "uuidOnly": {
            "type": "object",
            "additionalProperties": {"type": "string", "format": "uuid", "default": "123E4567E89B12D3A456426614174000"}
