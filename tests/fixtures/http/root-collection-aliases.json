{
  "openapi": "3.1.0", "info": {"title": "Root Collection Alias API", "version": "1"},
  "components": {"schemas": {
    "AValues": {"$ref": "#/components/schemas/BValues"},
    "BValues": {"$ref": "#/components/schemas/ZValues"},
    "ANarrow": {"$ref": "#/components/schemas/BValues", "nullable": false},
    "AMap": {"$ref": "#/components/schemas/ZMap"},
    "AMapNarrow": {"$ref": "#/components/schemas/AMap", "nullable": false},
    "AOpen": {"$ref": "#/components/schemas/ZOpen"},
    "AForceNullable": {"$ref": "#/components/schemas/ZItems", "nullable": true},
    "ARows": {"$ref": "#/components/schemas/ZRows"},
    "Holder": {"properties": {
      "values": {"$ref": "#/components/schemas/AValues"},
      "narrow": {"$ref": "#/components/schemas/ANarrow"},
      "wrapped": {"allOf": [{"$ref": "#/components/schemas/AValues"}]},
      "wrappedNarrow": {"allOf": [{"$ref": "#/components/schemas/AValues"}], "nullable": false},
      "map": {"$ref": "#/components/schemas/AMap"},
      "mapNarrow": {"$ref": "#/components/schemas/AMapNarrow"},
      "mapUseNarrow": {"$ref": "#/components/schemas/AMap", "nullable": false},
      "open": {"$ref": "#/components/schemas/AOpen"},
      "forced": {"$ref": "#/components/schemas/AForceNullable"},
      "rows": {"$ref": "#/components/schemas/ARows"},
      "nested": {"type": "array", "items": {"$ref": "#/components/schemas/AValues"}}
    }, "required": ["values", "narrow", "wrapped", "wrappedNarrow", "map", "mapNarrow", "mapUseNarrow", "open", "forced", "rows", "nested"]},
    "ZValues": {"type": ["array", "null"], "items": {"type": ["string", "null"]}},
    "ZMap": {"type": "object", "nullable": true, "additionalProperties": {"type": ["string", "null"]}},
    "ZOpen": {"type": "object", "nullable": true, "additionalProperties": true},
    "ZItems": {"type": "array", "items": {"type": "string"}},
    "ZRows": {"type": "array", "items": {"properties": {"id": {"type": "string"}, "children": {"$ref": "#/components/schemas/ARows"}}, "required": ["id"]}}
  }},
  "paths": {
    "/alias": {"post": {"operationId": "echo", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AValues"}}}}, "responses": {"200": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/AValues"}}}}}}},
    "/direct": {"post": {"operationId": "echo", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ZValues"}}}}, "responses": {"200": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/ZValues"}}}}}}},
    "/map": {"post": {"operationId": "echoMap", "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/AMapNarrow"}}}}, "responses": {"200": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/AMapNarrow"}}}}}}},
    "/patch": {"patch": {"operationId": "submit", "requestBody": {"required": true, "content": {"application/json": {"schema": {"properties": {
      "optional": {"$ref": "#/components/schemas/AValues"},
      "map": {"allOf": [{"$ref": "#/components/schemas/AMap"}]},
      "forced": {"$ref": "#/components/schemas/AForceNullable"},
      "requiredNull": {"$ref": "#/components/schemas/AValues"},
      "requiredNarrow": {"$ref": "#/components/schemas/AMapNarrow"}
    }, "required": ["requiredNull", "requiredNarrow"]}}}}, "responses": {"204": {}}}},
    "/events": {"get": {"operationId": "watch", "responses": {"200": {"content": {"text/event-stream": {"schema": {"oneOf": [
      {"properties": {"event": {"type": "string", "const": "values"}, "data": {"$ref": "#/components/schemas/AValues"}}, "required": ["data"]},
      {"properties": {"event": {"type": "string", "const": "map"}, "data": {"$ref": "#/components/schemas/AMapNarrow"}}, "required": ["data"]}
    ]}}}}}}}
  }
}
