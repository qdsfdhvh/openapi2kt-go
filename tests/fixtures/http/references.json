{
  "openapi": "3.1.0",
  "info": {"title": "Reference API", "version": "1.0"},
  "servers": [{"url": "https://api.example.test"}],
  "paths": {
    "/widgets/{id}": {
      "parameters": [{"$ref": "#/components/parameters/PathId"}, {"$ref": "#/components/parameters/LimitChain"}],
      "post": {
        "operationId": "send",
        "parameters": [{"$ref": "#/components/parameters/LimitOverride"}, {"$ref": "#/x-parameter-pool/0"}],
        "requestBody": {"$ref": "#/components/requestBodies/InputChain"},
        "responses": {"200": {"$ref": "#/components/responses/ReplyChain"}}
      }
    }
  },
  "x-parameter-pool": [{"name": "X-Trace", "in": "header", "schema": {"type": "string"}, "example": {"$ref": "#/does/not/exist"}}],
  "components": {
    "parameters": {
      "PathId": {"name": "id", "in": "path", "required": true, "schema": {"type": "string"}},
      "LimitChain": {"$ref": "#/components/parameters/Limit~1~0"},
      "Limit/~": {"name": "limit", "in": "query", "schema": {"type": "integer"}},
      "LimitOverride": {"name": "limit", "in": "query", "schema": {"type": "integer", "format": "int64"}}
    },
    "requestBodies": {
      "InputChain": {"$ref": "#/components/requestBodies/Input", "description": "Reference annotation"},
      "Input": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Widget"}, "example": {"$ref": "https://example.test/not-resolved"}}}}
    },
    "responses": {
      "ReplyChain": {"$ref": "#/components/responses/Reply"},
      "Reply": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/Widget"}}}}
    },
    "schemas": {"Widget": {"type": "object", "required": ["id"], "properties": {"id": {"type": "string"}}}}
  }
}
