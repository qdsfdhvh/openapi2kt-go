{
  "openapi": "3.1.0",
  "components": {
    "schemas": {
      "Item": {
        "properties": {
          "id": {
            "type": "string"
          },
          "version": {
            "type": "integer",
            "default": 0,
            "enum": [
              0,
              1
            ]
          },
          "amount": {
            "type": "number"
          },
          "weight": {
            "type": "number",
            "format": "float",
            "default": 0,
            "enum": [
              0,
              1
            ]
          },
          "uuid": {
            "type": "string",
            "format": "uuid"
          },
          "instant": {
            "type": "string",
            "format": "date-time"
          },
          "day": {
            "type": "string",
            "format": "date"
          },
          "flag": {
            "type": "boolean",
            "default": false,
            "enum": [
              false,
              true
            ]
          },
          "state": {
            "type": "string",
            "enum": [
              "ready",
              "done"
            ],
            "default": "ready"
          },
          "kind": {
            "const": "fixed"
          },
          "pinnedFlag": {
            "type": "boolean",
            "const": false
          },
          "pinnedNumber": {
            "type": "number",
            "const": -0.0
          }
        },
        "required": [
          "id"
        ]
      },
      "Holder": {
        "properties": {
          "values": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Item"
            },
            "uniqueItems": true
          }
        }
      },
      "NullableHolder": {
        "properties": {
          "values": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Item",
              "nullable": true
            },
            "uniqueItems": true
          }
        }
      },
      "DefaultHolder": {
        "properties": {
          "values": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Item"
            },
            "uniqueItems": true,
            "default": [
              {
                "id": "default"
              }
            ]
          }
        }
      },
      "InlineHolder": {
        "properties": {
          "values": {
            "type": "array",
            "items": {
              "properties": {
                "id": {
                  "type": "string"
                },
                "state": {
                  "type": "string",
                  "enum": [
                    "ready",
                    "done"
                  ],
                  "default": "ready"
                },
                "kind": {
                  "const": "fixed"
                }
              },
              "required": [
                "id"
              ]
            },
            "uniqueItems": true
          }
        }
      }
    }
  },
  "paths": {
    "/send": {
      "post": {
        "operationId": "send",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Holder"
              }
            }
          }
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Holder"
                }
              }
            }
          }
        }
      }
    },
    "/watch": {
      "post": {
        "operationId": "watch",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Holder"
              }
            }
          }
        },
        "responses": {
          "200": {
            "content": {
              "text/event-stream": {
                "schema": {
                  "properties": {
                    "event": {
                      "const": "record"
                    },
                    "data": {
                      "$ref": "#/components/schemas/Holder"
                    }
                  },
                  "required": [
                    "event",
                    "data"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/patch": {
      "patch": {
        "operationId": "patch",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "value": {
                    "$ref": "#/components/schemas/Holder",
                    "nullable": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "204": {}
        }
      }
    }
  }
}
