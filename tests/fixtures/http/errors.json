{
  "openapi": "3.1.0",
  "info": {"title": "Error Contract", "version": "1.0"},
  "servers": [{"url": "https://api.example.test"}],
  "components": {
    "schemas": {"Problem": {"type": "object", "required": ["message"], "properties": {"message": {"type": "string"}}}},
    "responses": {"BadInput": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/Problem"}}}}}
  },
  "paths": {
    "/result": {"get": {
      "operationId": "fetch",
      "summary": "Read a result safely */ without source injection",
      "responses": {
        "default": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/Problem"}}}},
        "5XX": {"content": {"application/problem+json": {"schema": {"$ref": "#/components/schemas/Problem"}}}},
        "404": {},
        "400": {"$ref": "#/components/responses/BadInput"},
        "409": {"content": {"application/json": {"schema": {"type": "object", "properties": {"reason": {"type": "string"}}}}}},
        "200": {"content": {"application/json": {"schema": {"type": "string"}}}}
      }
    }},
    "/silent": {"get": {"operationId": "silent", "tags": ["Quiet"], "responses": {"204": {}, "404": {}}}}
  }
}
