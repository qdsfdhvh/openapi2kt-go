{
  "openapi": "3.1.0",
  "info": {"title": "Collection Chain API", "version": "1"},
  "components": {"schemas": {
    "Record": {
      "properties": {
        "values": {"$ref": "#/components/schemas/Source/properties/nullableHop", "nullable": false},
        "entries": {"$ref": "#/components/schemas/Source/properties/map"},
        "inherited": {"$ref": "#/components/schemas/Source/properties/nullableHop"},
        "mixed": {"$ref": "#/components/schemas/Source/properties/mixed"}
      },
      "required": ["values", "entries"]
    },
    "Source": {"properties": {
      "leaf/key~": {"type": ["string", "null"], "minLength": 2, "maxLength": 3, "pattern": "^[a-z]+$"},
      "leafHop": {"$ref": "#/components/schemas/Source/properties/leaf~1key~0"},
      "list": {
        "type": ["array", "null"], "minItems": 1, "maxItems": 3, "uniqueItems": true,
        "items": {"$ref": "#/components/schemas/Source/properties/leafHop"}
      },
      "falseHop": {"$ref": "#/components/schemas/Source/properties/list", "nullable": false},
      "inheritedHop": {"$ref": "#/components/schemas/Source/properties/falseHop"},
      "nullableHop": {"$ref": "#/components/schemas/Source/properties/inheritedHop", "nullable": true},
      "map": {
        "type": "object", "minProperties": 1, "maxProperties": 2,
        "additionalProperties": {"$ref": "#/components/schemas/Source/properties/inheritedHop"}
      },
      "mixed": {
        "type": "array", "minItems": 1, "maxItems": 2,
        "items": {"$ref": "#/components/schemas/Source/properties/map", "nullable": true}
      }
    }}
  }},
  "paths": {
    "/values": {"post": {
      "operationId": "echo",
      "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Source/properties/inheritedHop"}}}},
      "responses": {"200": {"content": {"application/json": {"schema": {"$ref": "#/components/schemas/Source/properties/inheritedHop"}}}}}
    }},
    "/patch": {"patch": {
      "operationId": "submit",
      "requestBody": {"required": true, "content": {"application/json": {"schema": {
        "properties": {
          "inherited": {"$ref": "#/components/schemas/Source/properties/nullableHop"},
          "wrapped": {"allOf": [{"$ref": "#/components/schemas/Source/properties/nullableHop"}]},
          "requiredNull": {"$ref": "#/components/schemas/Source/properties/nullableHop"},
          "requiredFalse": {"$ref": "#/components/schemas/Source/properties/nullableHop", "nullable": false}
        },
        "required": ["requiredNull", "requiredFalse"]
      }}}},
      "responses": {"204": {}}
    }},
    "/events": {"get": {
      "operationId": "watch",
      "responses": {"200": {"content": {"text/event-stream": {"schema": {
        "properties": {
          "event": {"type": "string", "const": "mixed"},
          "data": {"$ref": "#/components/schemas/Source/properties/mixed"}
        }, "required": ["data"]
      }}}}}
    }}
  }
}
