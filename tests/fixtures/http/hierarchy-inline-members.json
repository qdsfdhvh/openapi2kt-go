{
  "openapi": "3.1.0",
  "info": {
    "title": "hierarchy-inline-members",
    "version": "1.0.0"
  },
  "paths": {
    "/shape": {
      "post": {
        "operationId": "shape",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Shape"
              }
            }
          }
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Shape"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Shape": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "circle"
              },
              "r": {
                "type": "integer"
              }
            },
            "required": [
              "kind",
              "r"
            ]
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "square"
              },
              "side": {
                "type": "integer"
              }
            },
            "required": [
              "kind",
              "side"
            ]
          }
        ],
        "discriminator": {
          "propertyName": "kind"
        }
      },
      "Tagged": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "only"
                ]
              },
              "note": {
                "type": "string"
              }
            },
            "required": [
              "kind",
              "note"
            ]
          }
        ],
        "discriminator": {
          "propertyName": "kind"
        }
      }
    }
  }
}
