{
  "openapi": "3.1.0",
  "info": {
    "title": "Referenced object collection defaults",
    "version": "1"
  },
  "components": {
    "schemas": {
      "Item": {
        "type": "object",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "age": {
            "type": "integer",
            "default": 7
          },
          "kind": {
            "type": "string",
            "enum": [
              "a",
              "b"
            ]
          },
          "code": {
            "type": "integer",
            "format": "int32",
            "enum": [
              1,
              2,
              3
            ]
          }
        }
      },
      "Rows": {
        "type": "array",
        "items": {
          "$ref": "#/components/schemas/Item"
        }
      },
      "MapRows": {
        "type": "object",
        "additionalProperties": {
          "$ref": "#/components/schemas/Item"
        }
      },
      "AllOfItem": {
        "allOf": [
          {"properties": {"name": {"type": "string"}}, "required": ["name"]},
          {"properties": {"age": {"type": "integer", "default": 7}, "code": {"type": "integer", "enum": [1, 2]}, "child": {"properties": {"note": {"type": "string", "default": "inner"}}}}}
        ]
      },
      "AllOfItemAlias": {"$ref": "#/components/schemas/AllOfItem"},
      "AllOfNodeHops": {"properties": {"node": {"$ref": "#/components/schemas/AllOfOwner/properties/node"}}},
      "AllOfNodeAlias": {"$ref": "#/components/schemas/AllOfNodeHops/properties/node"},
      "AllOfRows": {
        "type": "array",
        "items": {"$ref": "#/components/schemas/AllOfItem"}
      },
      "AllOfAlias": {"$ref": "#/components/schemas/AllOfRows"},
      "AllOfOwner": {
        "properties": {
          "node": {
            "allOf": [
              {"properties": {"name": {"type": "string"}}, "required": ["name"]},
              {"properties": {"child": {"properties": {"note": {"type": "string", "default": "inner"}}}}}
            ]
          }
        }
      },
      "AllOfNested": {
        "type": "array",
        "items": {"type": "object", "additionalProperties": {"$ref": "#/components/schemas/AllOfOwner/properties/node", "nullable": true}}
      },
      "AllOfNullableRows": {"type": "array", "items": {"$ref": "#/components/schemas/AllOfItem", "nullable": true}},
      "BareAllRows": {
        "type": "array",
        "items": {"allOf": [
          {"properties": {"name": {"type": "string"}}, "required": ["name"]},
          {"properties": {"age": {"type": "integer", "default": 7}, "code": {"type": "integer", "enum": [1, 2]}, "child": {"properties": {"note": {"type": "string", "default": "inner"}}}}}
        ]}
      },
      "BareAllAlias": {"$ref": "#/components/schemas/BareAllRows"},
      "BareAllMaps": {
        "type": "object",
        "additionalProperties": {"allOf": [
          {"properties": {"name": {"type": "string"}}, "required": ["name"]},
          {"properties": {"age": {"type": "integer", "default": 7}}}
        ]}
      },
      "BareAllMixed": {
        "type": "array",
        "items": {"type": "object", "additionalProperties": {"allOf": [
          {"properties": {"name": {"type": "string"}}, "required": ["name"]},
          {"properties": {"child": {"properties": {"note": {"type": "string", "default": "inner"}}}}}
        ]}}
      },
      "BareAllNullable": {
        "type": "array",
        "items": {"allOf": [
          {"nullable": true, "properties": {"name": {"type": "string"}}, "required": ["name"]},
          {"nullable": true, "properties": {"age": {"type": "integer", "default": 7}}}
        ]}
      },
      "BareAllRequired": {
        "properties": {"rows": {"$ref": "#/components/schemas/BareAllRows", "default": [{"name": "required-bare"}]}},
        "required": ["rows"]
      },
      "InlineAllOfRequired": {
        "properties": {"rows": {"type": "array", "items": {"$ref": "#/components/schemas/AllOfItem"}, "default": [{"name": "required-inline"}]}},
        "required": ["rows"]
      },
      "AllOfRequired": {
        "properties": {"rows": {"$ref": "#/components/schemas/AllOfRows", "default": [{"name": "required"}]}},
        "required": ["rows"]
      },
      "Holder": {
        "type": "object",
        "properties": {
          "inlineRows": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Item"
            },
            "default": [
              {
                "name": "a",
                "kind": "a"
              },
              {
                "name": "b",
                "age": 3,
                "code": 2
              }
            ]
          },
          "inlineMap": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/Item"
            },
            "default": {
              "k": {
                "name": "c"
              }
            }
          },
          "namedRows": {
            "$ref": "#/components/schemas/Rows",
            "default": [
              {
                "name": "d"
              }
            ]
          },
          "namedMap": {
            "$ref": "#/components/schemas/MapRows",
            "default": {
              "m": {
                "name": "e"
              }
            }
          },
          "requiredRows": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Item"
            },
            "default": [
              {
                "name": "r"
              }
            ]
          },
          "nilRows": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "$ref": "#/components/schemas/Item"
            },
            "default": null
          },
          "inlineAllRows": {"type": "array", "items": {"$ref": "#/components/schemas/AllOfItemAlias"}, "default": [{"name": "inline", "child": {}}]},
          "inlineAllMap": {"type": "object", "additionalProperties": {"$ref": "#/components/schemas/AllOfItem"}, "default": {"k": {"name": "map"}}},
          "inlineAllMixed": {"type": "array", "items": {"type": "object", "additionalProperties": {"$ref": "#/components/schemas/AllOfNodeAlias"}}, "default": [{"k": {"name": "internal-inline", "child": {}}}]},
          "inlineAllNullable": {"type": "array", "items": {"$ref": "#/components/schemas/AllOfItem", "nullable": true}, "default": [null, {"name": "nullable-inline"}]},
          "inlineAllNil": {"type": ["array", "null"], "items": {"$ref": "#/components/schemas/AllOfItem"}, "default": null},
          "allOfRows": {"$ref": "#/components/schemas/AllOfRows", "default": [{"name": "all", "child": {}}]},
          "allOfAlias": {"$ref": "#/components/schemas/AllOfAlias", "default": [{"name": "alias"}]},
          "allOfNested": {"$ref": "#/components/schemas/AllOfNested", "default": [{"k": {"name": "internal", "child": {}}, "nil": null}]},
          "allOfNullable": {"$ref": "#/components/schemas/AllOfNullableRows", "default": [null, {"name": "nullable"}]},
          "allOfNil": {"$ref": "#/components/schemas/AllOfRows", "nullable": true, "default": null},
          "bareRows": {"$ref": "#/components/schemas/BareAllRows", "default": [{"name": "bare", "child": {}}]},
          "bareAlias": {"$ref": "#/components/schemas/BareAllAlias", "default": [{"name": "bare-alias"}]},
          "bareMaps": {"$ref": "#/components/schemas/BareAllMaps", "default": {"k": {"name": "bare-map"}}},
          "bareMixed": {"$ref": "#/components/schemas/BareAllMixed", "default": [{"k": {"name": "bare-mixed", "child": {}}}]},
          "bareNullable": {"$ref": "#/components/schemas/BareAllNullable", "default": [null, {"name": "bare-nullable"}]},
          "bareNil": {"$ref": "#/components/schemas/BareAllRows", "nullable": true, "default": null}
        },
        "required": [
          "requiredRows"
        ]
      },
      "RequiredCfg": {
        "type": "object",
        "properties": {
          "rows": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Item"
            },
            "default": [
              {
                "name": "v"
              }
            ]
          }
        },
        "required": [
          "rows"
        ]
      }
    }
  },
  "paths": {
    "/holder": {
      "post": {
        "operationId": "sendHolder",
        "tags": [
          "defaults"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Holder"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Holder",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Holder"
                }
              }
            }
          }
        }
      }
    },
    "/patch": {
      "patch": {
        "operationId": "patchHolder",
        "tags": [
          "defaults"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "required": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "inlineAllRows": {"type": ["array", "null"], "items": {"$ref": "#/components/schemas/AllOfNodeAlias"}, "default": [{"name": "patch-inline"}]},
                  "bareRows": {"$ref": "#/components/schemas/BareAllRows", "nullable": true, "default": [{"name": "patch-bare"}]},
                  "allOfRows": {"$ref": "#/components/schemas/AllOfRows", "nullable": true, "default": [{"name": "patch"}]},
                  "rows": {
                    "type": [
                      "array",
                      "null"
                    ],
                    "items": {
                      "$ref": "#/components/schemas/Item"
                    },
                    "default": [
                      {
                        "name": "p"
                      }
                    ]
                  }
                },
                "required": [
                  "required"
                ]
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Updated"
          }
        }
      }
    },
    "/events": {
      "get": {
        "operationId": "watchHolders",
        "tags": [
          "defaults"
        ],
        "responses": {
          "200": {
            "description": "Events",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "event": {
                      "const": "holder"
                    },
                    "data": {
                      "$ref": "#/components/schemas/Holder"
                    }
                  },
                  "required": [
                    "event",
                    "data"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/required": {
      "post": {
        "operationId": "sendRequired",
        "tags": [
          "defaults"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RequiredCfg"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequiredCfg"
                }
              }
            }
          }
        }
      }
    }
  }
}
